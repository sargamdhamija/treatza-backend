# Copy this file to ".env" (same folder as the .java files) and fill in your values.
# Never commit the real ".env" file anywhere public.

PORT=4000

# Password that protects the admin dashboard and the orders API.
ADMIN_KEY=treatza123

# Your Neon (or any Postgres) connection string.
# From Neon: dashboard.neon.tech -> your project -> "Connection string"
# It looks like:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# From your Razorpay Dashboard -> Settings -> API Keys. Test keys work immediately.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard -> Settings -> Webhooks, after you add the webhook (see README).
RAZORPAY_WEBHOOK_SECRET=

# From Firebase Console -> Project Settings (gear icon) -> General -> Project ID.
FIREBASE_PROJECT_ID=treatzabakery

# Path to the service account JSON file (Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key). Used to send push notifications.
# Default is fine if the file sits in the same folder as the .java files.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# From Google Cloud Console -> APIs & Services -> Credentials, after enabling
# the "Distance Matrix API" and attaching a billing account to the project.
# Leave blank to fall back to the flat delivery fee.
GOOGLE_MAPS_API_KEY=
