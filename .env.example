# Copy this file to ".env" (same folder as the .java files) and fill in your values.
# Never commit the real ".env" file anywhere public.

PORT=4000

# Password that protects the admin dashboard and the orders API.
ADMIN_KEY=treatza123

# Your Neon (or any Postgres) connection string.
# From Neon: dashboard.neon.tech -> your project -> "Connection string"
# It looks like:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# From your Razorpay Dashboard -> Settings -> API Keys. Test keys work immediately.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard -> Settings -> Webhooks, after you add the webhook (see README).
RAZORPAY_WEBHOOK_SECRET=
